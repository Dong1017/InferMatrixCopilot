  {COPILOT_PYTHON} -c 'import sys; from infermatrix_copilot.testing.process_tree import kill_tree; pid=int(sys.argv[1]); kill_tree([pid], identity=dict([(pid, int(sys.argv[2]))]))' '<verified_orphan_pid>' '<verified_orphan_starttime_ticks>'
